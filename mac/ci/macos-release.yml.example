# macOS 发布流水线（草稿，未启用）
#
# 现有的 .github/workflows/dotnet-build.yml 只在 windows-latest 上构建，
# 不涉及 macOS。若要让 macOS 版也随 tag 自动发布，可把本文件复制到
# .github/workflows/ 下启用。
#
# 之所以放在 mac/ 而不是直接改 .github/：那属于本目录之外的改动，
# 应由仓库维护者决定是否引入。
#
# 与 Windows 版流水线的对应关系：
#   Windows: 打 v* tag → 构建 → 上传 exe（framework 与 withruntime 两种）
#   本文件:  打 v* tag → 构建 → 上传 zip（同样两种，arm64 与 x64）
#
# 尚未包含代码签名与公证。要免掉用户手动绕过 Gatekeeper，需要 Apple 开发者
# 证书，并把以下 secrets 配好后补上 codesign / notarytool 步骤：
#   MACOS_CERTIFICATE、MACOS_CERTIFICATE_PWD、APPLE_ID、APPLE_TEAM_ID、
#   APPLE_APP_PASSWORD

name: macOS Release

on:
  push:
    tags:
      - "v*"
  workflow_dispatch:

jobs:
  build:
    name: Build macOS app
    runs-on: macos-14
    strategy:
      matrix:
        rid: [osx-arm64, osx-x64]

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: "10.0.x"

      - name: Package (framework dependent)
        run: ./package-app.sh ${{ matrix.rid }}
        working-directory: mac

      - name: Package (self contained)
        run: ./package-app.sh --with-runtime ${{ matrix.rid }}
        working-directory: mac

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: macos-${{ matrix.rid }}
          path: mac/out/*.zip

  release:
    name: Attach to release
    needs: build
    runs-on: ubuntu-latest
    if: startsWith(github.ref, 'refs/tags/v')

    steps:
      - name: Download artifacts
        uses: actions/download-artifact@v4
        with:
          path: ./assets

      - name: Publish
        uses: softprops/action-gh-release@v2
        with:
          files: ./assets/**/*.zip
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
